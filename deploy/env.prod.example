# /opt/graphrecall/.env on the server (chmod 600, owner deploy). Never commit the real file.
# backend/config/production.py refuses to start if a required value is missing or unsafe.

API_DOMAIN=api.example.com
GRAPHRECALL_IMAGE=ghcr.io/usnaveen/graphrecall-api:latest

# Databases (internal to the compose network; generate long random values)
POSTGRES_PASSWORD=
NEO4J_PASSWORD=

# LLM (billed key; per-user daily caps below protect the bill)
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
QUOTA_INGEST_PER_DAY=40
QUOTA_CHAT_PER_DAY=300
RATE_LIMIT_PER_MIN=120
AGENT_V2_MAX_RPM=12

# Sign-in: the iOS and web OAuth client IDs (comma-separated)
GOOGLE_CLIENT_IDS=
# Signs GraphRecall session tokens and encrypts stored Apple refresh tokens: `openssl rand -base64 48`.
# Rotating it signs everyone out AND makes stored Apple tokens unrevocable (users re-link on next sign-in).
SESSION_SECRET=
# Sign in with Apple: bundle ID (plus a web Services ID if used). The key (Certificates, IDs &
# Profiles > Keys, "Sign in with Apple") lets account deletion revoke Apple tokens.
APPLE_CLIENT_IDS=com.usnaveen.graphrecall
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of AuthKey_<KEY_ID>.p8, newlines as \n
APPLE_PRIVATE_KEY=

# Only the app's web origins (no '*', no localhost)
CORS_ORIGINS=https://app.example.com

# Object storage for uploads (Cloudflare R2, S3-compatible)
S3_BUCKET_NAME=graphrecall-uploads
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_URL_BASE=

# Backups (a separate R2 bucket with a 14-day lifecycle rule)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=graphrecall-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Must stay off in production
DEBUG=false
