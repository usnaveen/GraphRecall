# Copy to .env (git-ignored) and fill in. docker-compose.yml supplies the database settings.

# Required — Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Host port for the API (use another if 8000 is taken on your machine)
API_PORT=8000

# Optional model overrides (defaults live in backend/config/llm.py)
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_FAST_MODEL=gemini-3.1-flash-lite
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Optional — web research for concept dumps
TAVILY_API_KEY=

# Optional — Google Sign-In (web client ID the backend verifies ID tokens against)
GOOGLE_CLIENT_ID=

# Optional — tracing with LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=GraphRecall-Dev

# Optional — file uploads to S3-compatible storage
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_PUBLIC_URL_BASE=
